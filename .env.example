# LLM 服务配置（示例，复制为 .env 后填写真实值）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Milvus 向量库
# MILVUS_HOST=127.0.0.1
# MILVUS_PORT=19530
# MILVUS_URI=http://127.0.0.1:19530

# MongoDB 历史记录
# MONGO_URI=mongodb://127.0.0.1:27017
# MONGO_DB=knowledge

# MinIO 对象存储
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=knowledge

# 模型路径 / 缓存目录（参考 readme.md 中 modelscope 配置）
# MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
# EMBEDDING_MODEL_DIR=D:/ai_models/modelscope_cache/models/BAAI/bge-m3

# 服务端口
# IMPORT_SERVICE_PORT=8000
# QUERY_SERVICE_PORT=8001
